{
  "name": "PipeBend",
  "description": "A 90-degree pipe bend with a real wall: the swept profile is an annulus, so the bore is open end to end. Volume is analytic (Pappus): pi*(od^2-id^2)/4 * (pi*bend_r/2).",
  "units": "mm",
  "material": "Stainless Steel",
  "parameters": [
    {
      "name": "tube_od",
      "value": 20
    },
    {
      "name": "wall",
      "value": 2,
      "comment": "pipe wall thickness"
    },
    {
      "name": "tube_id",
      "value": "tube_od - 2 * wall",
      "comment": "bore, driven by the wall"
    },
    {
      "name": "bend_r",
      "value": 45,
      "comment": "centreline radius"
    }
  ],
  "operations": [
    {
      "op": "sketch",
      "name": "Path",
      "plane": "xy",
      "entities": [
        {
          "type": "arc",
          "center": [
            0,
            0
          ],
          "radius": "bend_r",
          "start_angle": 0,
          "end_angle": 90
        }
      ]
    },
    {
      "op": "sketch",
      "name": "Profile",
      "plane": "yz",
      "entities": [
        {
          "type": "circle",
          "center": [
            "bend_r",
            0
          ],
          "diameter": "tube_od"
        },
        {
          "type": "circle",
          "center": [
            "bend_r",
            0
          ],
          "diameter": "tube_id"
        }
      ]
    },
    {
      "op": "sweep",
      "name": "Tube",
      "profile_sketch": "Profile",
      "path_sketch": "Path"
    }
  ],
  "dfm": {
    "parameters": {
      "wall": "wall"
    },
    "frozen": [
      "tube_id",
      "bend_r"
    ],
    "settings": {
      "material": "pp",
      "checks": {
        "ribs": false
      }
    }
  }
}
